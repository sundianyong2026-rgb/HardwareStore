@model Product
@using System.Text.Json
@{
    ViewData["Title"] = "Edit product";
    ViewBag.MerchantMenu = "products";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var categoryDepths = ViewBag.CategoryDepths as Dictionary<int, int> ?? new Dictionary<int, int>();
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
    var isNew = Model.ProductId == 0;
    var specs = Model.Skus.OrderBy(s => s.SkuId).ToList();
    var gallery = Model.Images.OrderBy(i => i.SortOrder).ToList();

    // Attribute dimensions of this product, with their value ids.
    var attrList = Model.Attributes.OrderBy(a => a.SortOrder).ToList();
    var initialAttrs = new List<Dictionary<string, object>>();
    foreach (var a in attrList)
        initialAttrs.Add(new Dictionary<string, object>
        {
            ["name"] = a.Name,
            ["values"] = a.Values.OrderBy(v => v.SortOrder)
                .Select(v => new Dictionary<string, object>
                {
                    ["id"] = v.ValueId, ["text"] = v.Value
                }).ToList()
        });

    // Products created before attributes existed keep one plain "Specification" group,
    // so their old prices and stocks are not lost when the page is opened.
    if (initialAttrs.Count == 0)
    {
        var oldSpecs = specs.Select(s => s.SkuSpec).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();
        initialAttrs.Add(new Dictionary<string, object>
        {
            ["name"] = "Specification",
            ["values"] = (oldSpecs.Count > 0 ? oldSpecs : new List<string> { "Default" })
                .Select(x => new Dictionary<string, object> { ["id"] = 0, ["text"] = x }).ToList()
        });
    }

    var initialSkus = new List<Dictionary<string, object>>();
    foreach (var sku in specs)
        initialSkus.Add(new Dictionary<string, object>
        {
            ["spec"] = sku.SkuSpec,
            ["price"] = sku.Price.ToString("0.00"),
            ["stock"] = sku.Stock,
            ["valueIds"] = sku.AttributeValueIds ?? ""
        });

    // Pictures that already exist: the main image first, then the gallery.
    var initialPictures = new List<Dictionary<string, object>>();
    if (!string.IsNullOrWhiteSpace(Model.MainImage))
        initialPictures.Add(new Dictionary<string, object>
        {
            ["key"] = "main", ["id"] = 0, ["src"] = Model.MainImage, ["full"] = Model.MainImage,
            ["existing"] = true
        });
    foreach (var img in gallery)
        initialPictures.Add(new Dictionary<string, object>
        {
            ["key"] = "img" + img.ImageId, ["id"] = img.ImageId, ["src"] = img.ImageUrl,
            ["full"] = img.ImageUrl, ["existing"] = true
        });
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <h1 class="h5 text-brand mb-3">@(isNew ? "New product" : "Edit product")</h1>

        <form method="post" asp-controller="Merchant" asp-action="EditProduct" enctype="multipart/form-data"
              id="productForm">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div id="pictureHidden"></div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label small">Product name *</label>
                            <input class="form-control" name="productName" value="@Model.ProductName" required maxlength="150" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label small">Status</label>
                            <select class="form-select" name="status">
                                <option value="on" selected="@(Model.Status != "off")">On sale</option>
                                <option value="off" selected="@(Model.Status == "off")">Off shelf</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Category *</label>
                            <select class="form-select" name="categoryId" required>
                                @foreach (var c in categories)
                                {
                                    var depth = categoryDepths.TryGetValue(c.CategoryId, out var d) ? d : 0;
                                    <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">
                                        @Html.Raw(string.Concat(Enumerable.Repeat("&nbsp;&nbsp;", depth)))@(depth > 0 ? "↳ " : "")@c.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Brand</label>
                            <select class="form-select" name="brandId">
                                <option value="">No brand</option>
                                @foreach (var b in brands)
                                {
                                    <option value="@b.BrandId" selected="@(Model.BrandId == b.BrandId)">@b.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Description</label>
                        <textarea class="form-control" name="description" rows="4">@Model.Description</textarea>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Pictures</span>
                    <span class="small text-muted"><span id="picCount">0</span> / 8</span>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <input type="file" id="picPicker" class="form-control form-control-sm" accept="image/*"
                               multiple style="max-width:420px;" />
                        <span class="small text-muted">
                            One upload entry, up to 8 pictures. The first picture is the main image.
                            Cropping is optional for every picture — square, rectangle or the whole picture.
                            Drag a picture to change the order.
                        </span>
                    </div>

                    <div id="picGrid" class="d-flex flex-wrap gap-3"></div>
                    <div id="picEmpty" class="small text-muted">No pictures yet.</div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Specifications / attributes</span>
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="addAttr">+ Add attribute</button>
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        A product can have any number of attribute groups (Color, Size, Capacity, ...).
                        Every combination gets its own price and stock.
                    </div>

                    <div id="attrEditor"></div>
                    <div id="attrHidden"></div>

                    <div class="mt-3 fw-semibold small">Combinations</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-1" id="comboTable">
                            <thead class="table-light">
                            <tr>
                                <th>Combination</th>
                                <th style="width:150px;">Price</th>
                                <th style="width:130px;">Stock</th>
                            </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div id="comboEmpty" class="small text-muted">Add an attribute and at least one value to generate combinations.</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-accent" type="submit">Save product</button>
                <a class="btn btn-outline-secondary" asp-controller="Merchant" asp-action="Products">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="cropModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crop picture</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div style="height:400px; background:#f6f6f6;">
                    <img id="cropTarget" style="max-width:100%; display:block;" alt="" />
                </div>
                <div class="small text-muted mt-2">
                    Drag or resize the box to any rectangle you like. Press "Use whole picture" to keep everything.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-outline-secondary" id="cropWhole">Use whole picture</button>
                <button type="button" class="btn btn-accent" id="cropApply">Apply crop</button>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.css" rel="stylesheet" />
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
(function () {
    var MAX_PICTURES = 8;
    var pictures = @Html.Raw(JsonSerializer.Serialize(initialPictures));

    var grid = document.getElementById('picGrid');
    var empty = document.getElementById('picEmpty');
    var counter = document.getElementById('picCount');
    var hidden = document.getElementById('pictureHidden');
    var picker = document.getElementById('picPicker');

    // ---------------- Attributes and combinations ----------------
    var attrs = @Html.Raw(JsonSerializer.Serialize(initialAttrs));
    var seedSkus = @Html.Raw(JsonSerializer.Serialize(initialSkus));

    // Prices are remembered by the text of the combination, so editing an attribute
    // value name does not silently shuffle money between combinations.
    var priceMap = {};

    (function seedPrices() {
        seedSkus.forEach(function (s) {
            var parts = [];

            if (s.valueIds) {
                var ids = String(s.valueIds).split(',');
                attrs.forEach(function (a, ai) {
                    var found = (a.values || []).filter(function (v) { return String(v.id) === ids[ai]; })[0];
                    parts.push(found ? found.text : '');
                });
            } else {
                parts = String(s.spec || '').split(' / ');
            }

            if (!parts.length || parts.join('') === '') return;
            priceMap[parts.join('|')] = { price: s.price, stock: String(s.stock) };
        });
    })();

    var attrEditor = document.getElementById('attrEditor');
    var comboBody = document.querySelector('#comboTable tbody');
    var comboEmpty = document.getElementById('comboEmpty');

    function validGroups() {
        return attrs.filter(function (a) { return a.name.trim() !== '' && a.values.length > 0; });
    }

    function renderAttrs() {
        attrEditor.innerHTML = '';

        attrs.forEach(function (a, ai) {
            var box = document.createElement('div');
            box.className = 'border rounded p-2 mb-2';
            box.dataset.ai = String(ai);

            var head = document.createElement('div');
            head.className = 'd-flex gap-2 align-items-center';
            head.innerHTML =
                '<input class="form-control form-control-sm" style="max-width:240px;" data-role="name"' +
                ' placeholder="Attribute name, e.g. Color" value="' + a.name.replace(/"/g, '&quot;') + '">' +
                '<button class="btn btn-sm btn-link text-danger p-0" type="button" data-act="delAttr">Delete attribute</button>';
            box.appendChild(head);

            var chips = document.createElement('div');
            chips.className = 'd-flex flex-wrap gap-2 align-items-center mt-2';
            a.values.forEach(function (v, vi) {
                var chip = document.createElement('span');
                chip.className = 'badge bg-light text-dark border fw-normal';
                chip.innerHTML = v.text.replace(/</g, '&lt;') +
                    ' <a href="#" data-act="delValue" data-vi="' + vi + '" class="text-danger text-decoration-none">&times;</a>';
                chips.appendChild(chip);
            });
            box.appendChild(chips);

            var adder = document.createElement('div');
            adder.className = 'd-flex gap-2 mt-2';
            adder.innerHTML =
                '<input class="form-control form-control-sm" style="max-width:200px;" data-role="newValue"' +
                ' placeholder="New value, e.g. Red">' +
                '<button class="btn btn-sm btn-outline-secondary" type="button" data-act="addValue">Add value</button>';
            box.appendChild(adder);

            attrEditor.appendChild(box);
        });

        buildAttrHidden();
        renderCombos();
    }

    // Names and values travel as two parallel lists; each attribute's values are "Red|Blue".
    function buildAttrHidden() {
        var host = document.getElementById('attrHidden');
        host.innerHTML = '';

        validGroups().forEach(function (a) {
            var n = document.createElement('input');
            n.type = 'hidden';
            n.name = 'attrName';
            n.value = a.name.trim();
            host.appendChild(n);

            var v = document.createElement('input');
            v.type = 'hidden';
            v.name = 'attrValues';
            v.value = a.values.map(function (x) { return x.text; }).join('|');
            host.appendChild(v);
        });
    }

    function cartesian(groups) {
        var out = [[]];
        groups.forEach(function (a, gi) {
            var next = [];
            out.forEach(function (row) {
                a.values.forEach(function (v, vi) {
                    next.push(row.concat([{ gi: gi, vi: vi, text: v.text }]));
                });
            });
            out = next;
        });
        return out;
    }

    function renderCombos() {
        var groups = validGroups();
        comboBody.innerHTML = '';

        if (!groups.length) {
            comboEmpty.style.display = 'block';
            return;
        }
        comboEmpty.style.display = 'none';

        cartesian(groups).forEach(function (combo) {
            var text = combo.map(function (c) { return c.text; }).join(' / ');
            var key = combo.map(function (c) { return c.gi + ':' + c.vi; }).join('|');
            var saved = priceMap[combo.map(function (c) { return c.text; }).join('|')] || { price: '0.00', stock: '0' };

            var tr = document.createElement('tr');
            tr.dataset.textKey = combo.map(function (c) { return c.text; }).join('|');
            tr.innerHTML =
                '<td class="small">' + text.replace(/</g, '&lt;') +
                '<input type="hidden" name="comboKey" value="' + key + '"></td>' +
                '<td><input class="form-control form-control-sm" type="number" step="0.01" name="comboPrice" value="' +
                saved.price + '"></td>' +
                '<td><input class="form-control form-control-sm" type="number" name="comboStock" value="' +
                saved.stock + '"></td>';
            comboBody.appendChild(tr);
        });
    }

    // Remember what the merchant typed before the table is rebuilt.
    comboBody.addEventListener('input', function (e) {
        var row = e.target.closest('tr');
        if (!row) return;
        var price = row.querySelector('input[name="comboPrice"]');
        var stock = row.querySelector('input[name="comboStock"]');
        priceMap[row.dataset.textKey] = { price: price.value, stock: stock.value };
    });

    attrEditor.addEventListener('click', function (e) {
        var act = e.target.dataset ? e.target.dataset.act : null;
        if (!act) return;
        e.preventDefault();

        var box = e.target.closest('[data-ai]');
        var ai = parseInt(box.dataset.ai, 10);

        if (act === 'addValue') {
            var input = box.querySelector('[data-role="newValue"]');
            var text = (input.value || '').trim();
            if (!text) return;
            if (!attrs[ai].values.some(function (v) { return v.text === text; })) {
                attrs[ai].values.push({ id: 0, text: text });
            }
            input.value = '';
            renderAttrs();
        } else if (act === 'delValue') {
            attrs[ai].values.splice(parseInt(e.target.dataset.vi, 10), 1);
            renderAttrs();
        } else if (act === 'delAttr') {
            attrs.splice(ai, 1);
            renderAttrs();
        }
    });

    // Pressing Enter inside a value box adds the value instead of saving the form.
    attrEditor.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        if (e.target.dataset && e.target.dataset.role === 'newValue') {
            e.preventDefault();
            var box = e.target.closest('[data-ai]');
            var btn = box.querySelector('[data-act="addValue"]');
            if (btn) btn.click();
        }
    });

    attrEditor.addEventListener('input', function (e) {
        if (!e.target.dataset || e.target.dataset.role !== 'name') return;
        var box = e.target.closest('[data-ai]');
        attrs[parseInt(box.dataset.ai, 10)].name = e.target.value;
        buildAttrHidden();
        renderCombos();
    });

    document.getElementById('addAttr').addEventListener('click', function () {
        attrs.push({ name: '', values: [] });
        renderAttrs();
        var boxes = attrEditor.querySelectorAll('[data-role="name"]');
        if (boxes.length) boxes[boxes.length - 1].focus();
    });

    // ---------------- Pictures ----------------
    function render() {
        grid.innerHTML = '';
        pictures.forEach(function (p, index) {
            var card = document.createElement('div');
            card.className = 'border rounded p-2 text-center bg-white';
            card.dataset.key = p.key;
            card.style.width = '140px';

            var img = document.createElement('img');
            img.src = p.src;
            img.style.cssText = 'width:104px;height:104px;object-fit:cover;border-radius:4px;cursor:grab;';
            card.appendChild(img);

            if (index === 0) {
                var badge = document.createElement('div');
                badge.className = 'badge bg-primary mt-1';
                badge.textContent = 'Main';
                card.appendChild(badge);
            } else {
                var note = document.createElement('div');
                note.className = 'small ' + (p.cropped ? 'text-success' : 'text-muted');
                note.textContent = p.cropped ? 'Cropped' : 'Picture ' + (index + 1);
                card.appendChild(note);
            }

            var bar = document.createElement('div');
            bar.className = 'd-flex flex-wrap gap-2 justify-content-center mt-1 small';
            bar.innerHTML =
                '<a href="#" data-act="crop">Crop</a>' +
                '<a href="#" data-act="replace">Replace</a>' +
                '<a href="#" data-act="remove" class="text-danger">Delete</a>' +
                (index > 0 ? '<a href="#" data-act="left">&larr;</a>' : '') +
                (index < pictures.length - 1 ? '<a href="#" data-act="right">&rarr;</a>' : '');
            card.appendChild(bar);

            grid.appendChild(card);
        });

        empty.style.display = pictures.length ? 'none' : 'block';
        counter.textContent = pictures.length;
        buildHiddenInputs();
    }

    function buildHiddenInputs() {
        hidden.innerHTML = '';

        if (pictures.length) {
            var main = document.createElement('input');
            main.type = 'hidden';
            main.name = 'mainImage';
            main.value = pictures[0].src;
            hidden.appendChild(main);
        } else {
            var clear = document.createElement('input');
            clear.type = 'hidden';
            clear.name = 'clearPictures';
            clear.value = '1';
            hidden.appendChild(clear);
        }

        pictures.slice(1).forEach(function (p) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = p.existing ? 'keepImageIds' : 'newImages';
            input.value = p.existing ? String(p.id) : p.src;
            hidden.appendChild(input);
        });
    }

    function indexOfKey(key) {
        for (var i = 0; i < pictures.length; i++) if (pictures[i].key === key) return i;
        return -1;
    }

    grid.addEventListener('click', function (e) {
        var act = e.target.dataset ? e.target.dataset.act : null;
        if (!act) return;
        e.preventDefault();

        var card = e.target.closest('[data-key]');
        var index = indexOfKey(card.dataset.key);
        var pic = pictures[index];
        if (!pic) return;

        if (act === 'crop') {
            openCrop(pic, index);
        } else if (act === 'replace') {
            replaceFile(pic, index);
        } else if (act === 'remove') {
            pictures.splice(index, 1);
            render();
        } else if (act === 'left' && index > 0) {
            pictures.splice(index - 1, 0, pictures.splice(index, 1)[0]);
            render();
        } else if (act === 'right' && index < pictures.length - 1) {
            pictures.splice(index + 1, 0, pictures.splice(index, 1)[0]);
            render();
        }
    });

    // Drag a picture to change its position (the first one becomes the main image).
    if (window.Sortable) {
        Sortable.create(grid, {
            animation: 150,
            onEnd: function () {
                var order = Array.prototype.map.call(grid.querySelectorAll('[data-key]'), function (el) {
                    return el.dataset.key;
                });
                var map = {};
                pictures.forEach(function (p) { map[p.key] = p; });
                pictures = order.map(function (k) { return map[k]; }).filter(Boolean);
                render();
            }
        });
    }

    // Downscale the picked file in the browser so that the upload stays small.
    function shrink(file, maxSide) {
        return new Promise(function (resolve) {
            var url = URL.createObjectURL(file);
            var img = new Image();
            img.onload = function () {
                var ratio = Math.min(1, maxSide / Math.max(img.width, img.height));
                var w = Math.round(img.width * ratio);
                var h = Math.round(img.height * ratio);
                var canvas = document.createElement('canvas');
                canvas.width = w;
                canvas.height = h;
                canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                URL.revokeObjectURL(url);
                resolve(canvas.toDataURL('image/jpeg', 0.85));
            };
            img.onerror = function () { URL.revokeObjectURL(url); resolve(null); };
            img.src = url;
        });
    }

    function uniqueKey() { return 'new' + Date.now() + Math.random().toString(36).slice(2, 7); }

    picker.addEventListener('change', function () {
        var files = Array.prototype.slice.call(picker.files || []);
        picker.value = '';
        if (!files.length) return;

        var room = MAX_PICTURES - pictures.length;
        if (room <= 0) {
            alert('A product can hold at most ' + MAX_PICTURES + ' pictures.');
            return;
        }
        if (files.length > room) {
            alert('Only ' + room + ' more picture(s) can be added.');
            files = files.slice(0, room);
        }

        Promise.all(files.map(function (f) { return shrink(f, 1200); })).then(function (results) {
            results.forEach(function (dataUrl) {
                if (!dataUrl) return;
                pictures.push({
                    key: uniqueKey(), id: 0, src: dataUrl, full: dataUrl, existing: false, cropped: false
                });
            });
            render();
        });
    });

    // ---- Cropper modal ----
    var modalEl = document.getElementById('cropModal');
    var modal = new bootstrap.Modal(modalEl);
    var target = document.getElementById('cropTarget');
    var cropper = null;
    var cropIndex = -1;

    function openCrop(pic, index) {
        cropIndex = index;
        modal.show();
    }

    modalEl.addEventListener('shown.bs.modal', function () {
        var pic = pictures[cropIndex];
        if (!pic) return;
        target.src = pic.full || pic.src;
        if (cropper) { cropper.destroy(); cropper = null; }
        cropper = new Cropper(target, {
            // No fixed ratio: the box can be a square, a wide rectangle or the whole picture.
            aspectRatio: NaN,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 1,
            guides: false,
            background: false,
            responsive: true
        });
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        if (cropper) { cropper.destroy(); cropper = null; }
        cropIndex = -1;
    });

    document.getElementById('cropApply').addEventListener('click', function () {
        var pic = pictures[cropIndex];
        if (!cropper || !pic) return;

        var canvas = cropper.getCroppedCanvas({ maxWidth: 1200, maxHeight: 1200 });
        if (!canvas) return;
        pic.src = canvas.toDataURL('image/jpeg', 0.85);
        pic.existing = false;
        pic.id = 0;
        pic.cropped = true;
        modal.hide();
        render();
    });

    // Keep the untouched picture instead of cropping it.
    document.getElementById('cropWhole').addEventListener('click', function () {
        var pic = pictures[cropIndex];
        if (!pic) return;
        if (pic.full) pic.src = pic.full;
        if (pic.full && pic.full.indexOf('/') === 0) {
            pic.existing = true;   // still the file that is already on the server
        } else {
            pic.existing = false;
            pic.id = 0;
        }
        pic.cropped = false;
        modal.hide();
        render();
    });

    // Replace a single picture with another file, then crop it.
    function replaceFile(pic, index) {
        var input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file) return;
            shrink(file, 1200).then(function (dataUrl) {
                if (!dataUrl) return;
                pic.src = dataUrl;
                pic.full = dataUrl;
                pic.existing = false;
                pic.id = 0;
                pic.cropped = false;
                render();
                openCrop(pic, index);
            });
        });
        input.click();
    }

    renderAttrs();
    render();
})();
</script>
}
