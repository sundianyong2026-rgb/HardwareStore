@model List<Product>
@{
    ViewData["Title"] = "My products";
    ViewBag.MerchantMenu = "products";
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0 text-brand">Products &amp; SKU</h1>
            <div class="d-flex gap-2">
                <form class="d-flex" method="get" asp-controller="Merchant" asp-action="Products">
                    <input class="form-control form-control-sm me-1" name="keyword" value="@ViewBag.Keyword"
                           placeholder="Search my products" />
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Search</button>
                </form>
                <a class="btn btn-sm btn-accent" asp-controller="Merchant" asp-action="EditProduct">New product</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-light border">You have no product yet.</div>
        }

        @foreach (var p in Model)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex">
                            <img class="thumb me-3" style="width:80px;height:80px;"
                                 src="@(p.MainImage ?? "/images/products/.gitkeep")" alt="" />
                            <div>
                                <div class="fw-semibold">@p.ProductName</div>
                                <div class="small text-muted">
                                    @p.Category?.Name | Status:
                                    <span class="badge @(p.Status == "on" ? "bg-success" : "bg-secondary")">
                                        @(p.Status == "on" ? "on sale" : "off shelf")
                                    </span>
                                    | Sold @p.SalesCount
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-1 align-items-start">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Merchant"
                               asp-action="EditProduct" asp-route-id="@p.ProductId">Edit</a>
                            <form method="post" asp-controller="Merchant" asp-action="ToggleProduct">
                                <input type="hidden" name="productId" value="@p.ProductId" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">
                                    @(p.Status == "on" ? "Take off" : "Put on sale")
                                </button>
                            </form>
                            <form method="post" asp-controller="Merchant" asp-action="DeleteProduct"
                                  onsubmit="return confirm('Delete this product?')">
                                <input type="hidden" name="productId" value="@p.ProductId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    </div>

                    <table class="table table-sm mt-3 mb-0">
                        <thead class="table-light">
                        <tr><th>Specification</th><th>Price</th><th>Stock</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var sku in p.Skus.OrderBy(s => s.SkuId))
                        {
                            <tr>
                                <td class="small">@sku.SkuSpec</td>
                                <td colspan="2">
                                    <form class="d-flex gap-1" method="post" asp-controller="Merchant" asp-action="UpdateSku">
                                        <input type="hidden" name="skuId" value="@sku.SkuId" />
                                        <input class="form-control form-control-sm" type="number" step="0.01"
                                               name="price" value="@sku.Price.ToString("0.00")" style="width:110px;" />
                                        <input class="form-control form-control-sm" type="number"
                                               name="stock" value="@sku.Stock" style="width:90px;" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Save</button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post" asp-controller="Merchant" asp-action="DeleteSku"
                                          onsubmit="return confirm('Delete this specification?')">
                                        <input type="hidden" name="skuId" value="@sku.SkuId" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Del</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
