@model MerchantDashboardVm
@{
    ViewData["Title"] = "Merchant dashboard";
    ViewBag.MerchantMenu = "dashboard";
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <h1 class="h5 text-brand mb-3">@ViewBag.ShopName</h1>

        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="card card-stat shadow-sm">
                    <div class="card-body py-2">
                        <div class="text-muted small">Products</div>
                        <div class="fs-5 fw-bold">@Model.ProductCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-stat shadow-sm">
                    <div class="card-body py-2">
                        <div class="text-muted small">SKUs</div>
                        <div class="fs-5 fw-bold">@Model.SkuCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-stat shadow-sm">
                    <div class="card-body py-2">
                        <div class="text-muted small">Orders</div>
                        <div class="fs-5 fw-bold">@Model.OrderCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-stat shadow-sm">
                    <div class="card-body py-2">
                        <div class="text-muted small">Paid amount</div>
                        <div class="fs-6 fw-bold price">@Model.SalesAmount.ToString("0.00")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Recent orders</span>
                <a class="small" asp-controller="Merchant" asp-action="Orders">All orders</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                    <tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Created</th></tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentOrders.Any())
                    {
                        foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td class="small">@o.OrderNo</td>
                                <td class="small">@o.ReceiverName</td>
                                <td class="small">@o.TotalAmount.ToString("0.00")</td>
                                <td><span class="badge bg-secondary">@o.Status</span></td>
                                <td class="small">@o.CreatedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="small text-muted">No order yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Shop account</span>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Message" asp-action="Index">Messages</a>
            </div>
            <div class="card-body">
                @if (ViewBag.DeletionRequestedAt != null)
                {
                    <div class="alert alert-warning small mb-2">
                        A shop closure request was sent on @(((DateTime)ViewBag.DeletionRequestedAt).ToString("yyyy-MM-dd HH:mm")).
                        It is waiting for the administrator.
                    </div>
                    <form method="post" asp-controller="Merchant" asp-action="CancelDeletion"
                          onsubmit="return confirm('Withdraw the closure request?')">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Withdraw request</button>
                    </form>
                }
                else
                {
                    <p class="small text-muted">
                        Closure is only possible when no order of this shop is unfinished.
                    </p>
                    <form method="post" asp-controller="Merchant" asp-action="RequestDeletion"
                          onsubmit="return confirm('Send the shop closure request?')">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Request shop closure</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
