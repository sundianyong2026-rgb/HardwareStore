@model List<(string Role, int Id, string Name, HardwareStore.Models.Entities.Message Last, int Count)>
@{
    ViewData["Title"] = "Messages";
    var myRole = ViewBag.Role as string ?? "";
    var supportRole = ViewBag.SupportRole as string ?? "";
    ViewBag.MerchantMenu = myRole == "merchant" ? "messages" : null;
    ViewBag.AdminMenu = myRole == "admin" ? "messages" : null;
}

<div class="row g-3">
    @if (myRole == "merchant")
    {
        <div class="col-lg-3">@await Html.PartialAsync("~/Views/Merchant/_Sidebar.cshtml")</div>
    }
    else if (myRole == "admin")
    {
        <div class="col-lg-3">@await Html.PartialAsync("~/Views/Admin/_Sidebar.cshtml")</div>
    }
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 text-brand mb-0">Messages</h1>
            @if (myRole == "customer")
            {
                <a class="btn btn-sm btn-outline-secondary" asp-controller="User" asp-action="Profile">Back to my account</a>
            }
            else if (myRole == "merchant")
            {
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Merchant" asp-action="Index">Back to dashboard</a>
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="Index">Back to dashboard</a>
            }
        </div>

        @if (supportRole != "")
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Platform support</div>
                        <div class="small text-muted">Ask the super administrator about rules, payouts or disputes.</div>
                    </div>
                    <a class="btn btn-sm btn-accent"
                       asp-controller="Message" asp-action="Chat" asp-route-peerRole="@supportRole" asp-route-peerId="0">
                        Open chat
                    </a>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-light border">No conversation yet.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="list-group list-group-flush">
                    @foreach (var t in Model)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div class="text-truncate">
                                <div class="fw-semibold small">
                                    @t.Name
                                    @if (t.Role == "merchant")
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Seller</span>
                                    }
                                    else if (t.Role == "admin")
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Support</span>
                                    }
                                </div>
                                <div class="small text-muted text-truncate" style="max-width:520px;">
                                    @t.Last.Body
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted">@t.Last.CreatedAt.ToString("MM-dd HH:mm")</span>
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Message" asp-action="Chat"
                                   asp-route-peerRole="@t.Role" asp-route-peerId="@t.Id">Open</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
