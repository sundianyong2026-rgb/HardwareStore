@model List<Customer>
@{
    ViewData["Title"] = "Customers";
    ViewBag.AdminMenu = "customers";
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0 text-brand">Customers</h1>
            <form class="d-flex" method="get" asp-controller="Admin" asp-action="Customers">
                <input class="form-control form-control-sm me-1" name="keyword"
                       value="@ViewBag.Keyword" placeholder="Username or phone" />
                <button class="btn btn-sm btn-outline-secondary" type="submit">Search</button>
            </form>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                    <tr><th>Username</th><th>Full name</th><th>Phone</th><th>Registered</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="small">@c.Username</td>
                            <td class="small">@c.FullName</td>
                            <td class="small">@c.Phone</td>
                            <td class="small">@c.RegisteredAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @{
                                    // One badge only: the state that matters right now.
                                    string stateText;
                                    string stateClass;
                                    if (c.DeletionRequestedAt != null) { stateText = "closure asked"; stateClass = "bg-warning text-dark"; }
                                    else if (c.IsDisabled) { stateText = "disabled"; stateClass = "bg-secondary"; }
                                    else { stateText = "active"; stateClass = "bg-success"; }
                                }
                                <span class="badge @stateClass">@stateText</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <form method="post" asp-controller="Admin" asp-action="ToggleCustomer">
                                        <input type="hidden" name="customerId" value="@c.CustomerId" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                                            @(c.IsDisabled ? "Enable" : "Disable")
                                        </button>
                                    </form>
                                    <form method="post" asp-controller="Admin" asp-action="ResetPassword"
                                          onsubmit="return confirm('Reset this password?')">
                                        <input type="hidden" name="customerId" value="@c.CustomerId" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Reset pwd</button>
                                    </form>
                                    @if (c.DeletionRequestedAt != null)
                                    {
                                        <form method="post" asp-controller="Admin" asp-action="DecideDeletion"
                                              onsubmit="return confirm('Close this account now?')">
                                            <input type="hidden" name="role" value="customer" />
                                            <input type="hidden" name="id" value="@c.CustomerId" />
                                            <input type="hidden" name="decision" value="approve" />
                                            <button class="btn btn-sm btn-danger" type="submit">Close account</button>
                                        </form>
                                        <form method="post" asp-controller="Admin" asp-action="DecideDeletion">
                                            <input type="hidden" name="role" value="customer" />
                                            <input type="hidden" name="id" value="@c.CustomerId" />
                                            <input type="hidden" name="decision" value="reject" />
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">Reject</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-center">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" asp-controller="Admin" asp-action="Customers"
                               asp-route-page="@p" asp-route-keyword="@ViewBag.Keyword">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
