@model StatsViewModel
@{
    ViewData["Title"] = "Statistics";
    ViewBag.AdminMenu = "stats";
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <h1 class="h5 text-brand mb-3">Statistics</h1>

        <form class="row g-2 align-items-end mb-3" method="get" asp-controller="Admin" asp-action="Stats">
            <div class="col-md-3">
                <label class="form-label small">From</label>
                <input class="form-control form-control-sm" type="date" name="from" value="@Model.From" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">To</label>
                <input class="form-control form-control-sm" type="date" name="to" value="@Model.To" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-accent" type="submit">Apply</button>
            </div>
        </form>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="card card-stat shadow-sm"><div class="card-body py-2">
                    <div class="small text-muted">Sales amount</div>
                    <div class="fw-bold price">@Model.SalesAmount.ToString("0.00")</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card card-stat shadow-sm"><div class="card-body py-2">
                    <div class="small text-muted">Orders</div>
                    <div class="fw-bold">@Model.OrderCount</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card card-stat shadow-sm"><div class="card-body py-2">
                    <div class="small text-muted">Product visits</div>
                    <div class="fw-bold">@Model.VisitCount</div>
                </div></div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">Sales and visits per day</div>
            <div class="card-body"><canvas id="statsChart" height="110"></canvas></div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Top selling products</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                    <tr><th>Product</th><th>Sold</th><th>Stock</th><th>Price from</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.TopProducts)
                    {
                        <tr>
                            <td class="small">@item.Product.ProductName</td>
                            <td class="small">@item.Product.SalesCount</td>
                            <td class="small">@item.TotalStock</td>
                            <td class="small">@item.MinPrice.ToString("0.00")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels));
    const sales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesValues));
    const visits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VisitValues));

    new Chart(document.getElementById('statsChart'), {
        data: {
            labels: labels,
            datasets: [
                {
                    type: 'line',
                    label: 'Sales',
                    data: sales,
                    borderColor: '#1f3a5f',
                    backgroundColor: 'rgba(31,58,95,0.15)',
                    fill: true,
                    tension: 0.3,
                    yAxisID: 'y'
                },
                {
                    type: 'bar',
                    label: 'Visits',
                    data: visits,
                    backgroundColor: '#f08c00',
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            plugins: { legend: { display: true } },
            scales: {
                y: { beginAtZero: true, position: 'left' },
                y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } }
            }
        }
    });
</script>
}
