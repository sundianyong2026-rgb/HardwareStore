@model List<Review>
@{
    ViewData["Title"] = "Review moderation";
    ViewBag.AdminMenu = "reviews";
    var hidden = ViewBag.Hidden as bool?;
}

<div class="row g-3">
    <div class="col-lg-3">@await Html.PartialAsync("_Sidebar")</div>
    <div class="col-lg-9">
        <h1 class="h5 text-brand mb-3">Review moderation</h1>

        <div class="mb-3 d-flex gap-2">
            <a class="btn btn-sm @(hidden == null ? "btn-accent" : "btn-outline-secondary")"
               asp-controller="Admin" asp-action="Reviews">All</a>
            <a class="btn btn-sm @(hidden == false ? "btn-accent" : "btn-outline-secondary")"
               asp-controller="Admin" asp-action="Reviews" asp-route-hidden="false">Visible</a>
            <a class="btn btn-sm @(hidden == true ? "btn-accent" : "btn-outline-secondary")"
               asp-controller="Admin" asp-action="Reviews" asp-route-hidden="true">Hidden</a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-light border">No review.</div>
        }

        @foreach (var r in Model)
        {
            <div class="card shadow-sm mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>@r.Product?.ProductName | by @(r.Customer?.Username)</span>
                        <span>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div class="text-warning">
                        @for (var i = 0; i < r.Rating; i++)
                        {
                            <span>★</span>
                        }
                    </div>
                    <div class="small">@r.Content</div>
                    @if (!string.IsNullOrEmpty(r.ImageUrl))
                    {
                        <img src="@r.ImageUrl" class="thumb mt-1" style="width:110px;height:110px;" alt="" />
                    }
                    <div class="d-flex gap-2 mt-2">
                        <form method="post" asp-controller="Admin" asp-action="ModerateReview">
                            <input type="hidden" name="reviewId" value="@r.ReviewId" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">
                                @(r.IsVisible ? "Hide" : "Show")
                            </button>
                        </form>
                        <form method="post" asp-controller="Admin" asp-action="DeleteReview"
                              onsubmit="return confirm('Delete this review?')">
                            <input type="hidden" name="reviewId" value="@r.ReviewId" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                        <span class="badge @(r.IsVisible ? "bg-success" : "bg-secondary") align-self-center">
                            @(r.IsVisible ? "visible" : "hidden")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
