@model CartViewModel
@{
    ViewData["Title"] = "Shopping cart";
}

<h1 class="h4 mb-3 text-brand">Shopping cart</h1>

@if (!Model.Lines.Any())
{
    <div class="alert alert-light border">
        Your cart is empty. <a asp-controller="Product" asp-action="List">Browse products</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th style="width:40px;">
                        <input class="form-check-input" type="checkbox" id="checkAll" checked />
                    </th>
                    <th>Product</th>
                    <th>Specification</th>
                    <th>Unit price</th>
                    <th style="width:150px;">Quantity</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>
                            <input class="form-check-input line-check" type="checkbox" checked
                                   value="@line.Item.CartItemId" data-subtotal="@line.Subtotal" />
                        </td>
                        <td>
                            <a class="d-flex align-items-center text-decoration-none text-dark"
                               asp-controller="Product" asp-action="Detail" asp-route-id="@line.Product.ProductId">
                                <img class="thumb me-2" src="@(line.Product.MainImage ?? "/images/products/.gitkeep")" alt="" />
                                <span class="small">@line.Product.ProductName</span>
                            </a>
                            @if (!line.StockEnough)
                            {
                                <div class="small text-danger">Only @line.Sku.Stock left in stock</div>
                            }
                        </td>
                        <td class="small">@line.Sku?.SkuSpec</td>
                        <td class="small">@line.Sku?.Price.ToString("0.00")</td>
                        <td>
                            <form method="post" asp-controller="Cart" asp-action="UpdateQuantity" class="d-flex gap-1">
                                <input type="hidden" name="cartItemId" value="@line.Item.CartItemId" />
                                <input class="form-control form-control-sm" type="number" name="quantity"
                                       value="@line.Item.Quantity" min="1" max="@(line.Sku?.Stock ?? 1)" style="width:70px;" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">OK</button>
                            </form>
                        </td>
                        <td class="price small">@line.Subtotal.ToString("0.00")</td>
                        <td>
                            <form method="post" asp-controller="Cart" asp-action="Remove">
                                <input type="hidden" name="cartItemId" value="@line.Item.CartItemId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-body d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Selected: <span id="selCount">@Model.Count</span> item(s) |
                Total: <span class="price" id="selTotal">@Model.Total.ToString("0.00")</span>
                <div class="mt-1">Free shipping on orders above 99.</div>
            </div>
            <button class="btn btn-accent" onclick="goCheckout()">Checkout selected</button>
        </div>
    </div>
}

@section Scripts {
<script>
    const all = document.getElementById('checkAll');
    const checks = document.querySelectorAll('.line-check');

    function refresh() {
        let total = 0, count = 0;
        checks.forEach(function (c) {
            if (c.checked) {
                total += parseFloat(c.dataset.subtotal);
                count += 1;
            }
        });
        document.getElementById('selTotal').textContent = total.toFixed(2);
        document.getElementById('selCount').textContent = count;
    }

    if (all) {
        all.addEventListener('change', function () {
            checks.forEach(function (c) { c.checked = all.checked; });
            refresh();
        });
    }
    checks.forEach(function (c) { c.addEventListener('change', refresh); });

    function goCheckout() {
        const ids = Array.from(checks).filter(c => c.checked).map(c => c.value);
        if (!ids.length) { alert('Please select at least one product.'); return; }
        window.location = '/Order/Checkout?ids=' + ids.join(',');
    }
</script>
}
