@model List<ViewLog>
@{
    ViewData["Title"] = "Browsing history";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0 text-brand">Browsing history</h1>
    @if (Model.Any())
    {
        <form method="post" asp-controller="User" asp-action="ClearHistory">
            <button class="btn btn-sm btn-outline-danger" type="submit"
                    onclick="return confirm('Clear all browsing history?')">Clear all</button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">No browsing history.</div>
}

<div class="list-group shadow-sm">
    @foreach (var v in Model)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <a class="d-flex align-items-center text-decoration-none text-dark"
               asp-controller="Product" asp-action="Detail" asp-route-id="@v.Product.ProductId">
                <img class="thumb me-2" src="@(v.Product.MainImage ?? "/images/products/.gitkeep")" alt="" />
                <div>
                    <div class="small">@v.Product.ProductName</div>
                    <div class="small text-muted">Viewed @v.ViewedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </a>
            <form method="post" asp-controller="User" asp-action="RemoveHistory">
                <input type="hidden" name="viewId" value="@v.ViewId" />
                <button class="btn btn-sm btn-outline-secondary" type="submit">Remove</button>
            </form>
        </div>
    }
</div>
