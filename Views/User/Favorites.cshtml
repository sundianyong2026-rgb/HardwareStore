@model List<Favorite>
@{
    ViewData["Title"] = "Favourites";
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<h1 class="h4 mb-3 text-brand">Favourites</h1>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        No favourite yet. <a asp-controller="Product" asp-action="List">Browse products</a>
    </div>
}

<div class="row g-3">
    @foreach (var f in Model)
    {
        <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm position-relative">
                <a asp-controller="Product" asp-action="Detail" asp-route-id="@f.Product.ProductId">
                    <img class="card-img-top" style="width:100%;height:180px;object-fit:cover;display:block;"
                         src="@(f.Product.MainImage ?? "/images/products/.gitkeep")" alt="" />
                </a>
                <div class="card-body p-2">
                    <div class="small text-truncate">
                        <a class="text-decoration-none text-dark stretched-link"
                           asp-controller="Product" asp-action="Detail"
                           asp-route-id="@f.Product.ProductId">@f.Product.ProductName</a>
                    </div>
                    <div class="price small">
                        @(f.Product.Skus.Any() ? f.Product.Skus.Min(s => s.Price).ToString("0.00") : "0.00")
                    </div>
                    <form method="post" asp-controller="User" asp-action="RemoveFavorite" class="position-relative">
                        <input type="hidden" name="favoriteId" value="@f.FavoriteId" />
                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">Remove</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-controller="User" asp-action="Favorites" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
